# Mattermost server URL (no trailing slash)
MATTERMOST_URL=https://mattermost.example.com

# Bot account access token (create under Admin Console > Integrations > Bot Accounts)
MATTERMOST_TOKEN=your_bot_token_here

# Team ID — find in Admin Console or via GET /api/v4/teams
MATTERMOST_TEAM_ID=your_team_id_here

# Channel ID for scheduled announcements (bot must be a member of this channel)
MATTERMOST_CHANNEL_ID=your_channel_id_here

# Port for the slash command webhook server
BOT_PORT=5000

# Timezone for scheduled jobs and date calculations (e.g. Europe/London, America/New_York)
TIMEZONE=UTC

# Verification tokens for each slash command
# (generated by Mattermost when you register each slash command)
SLASH_TOKEN_HOLIDAY_ADD=your_token_here
SLASH_TOKEN_HOLIDAY_LIST=your_token_here
SLASH_TOKEN_HOLIDAY_DELETE=your_token_here
SLASH_TOKEN_BIRTHDAY_SET=your_token_here
SLASH_TOKEN_BIRTHDAY_DELETE=your_token_here
SLASH_TOKEN_AWAY_TODAY=your_token_here
