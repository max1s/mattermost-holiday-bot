# Mattermost server URL (no trailing slash)
MATTERMOST_URL=https://mattermost.example.com

# Bot account access token (create under Admin Console > Integrations > Bot Accounts)
MATTERMOST_TOKEN=your_bot_token_here

# Team ID — find in Admin Console or via GET /api/v4/teams
MATTERMOST_TEAM_ID=your_team_id_here

# Channel ID for scheduled announcements (bot must be a member of this channel)
MATTERMOST_CHANNEL_ID=your_channel_id_here

# Port for the slash command webhook server
BOT_PORT=5000

# Path to the SQLite database file.
# Defaults to ~/.local/share/mattermost-holiday-bot/bot.db — a permanent location
# that persists across bot restarts regardless of launch directory.
# The directory is created automatically if it doesn't exist.
# DB_PATH=/path/to/your/bot.db

# Timezone for scheduled jobs and date calculations
TIMEZONE=Europe/London

# Date format used for both user input in commands and display throughout the bot.
# Default: DD-MM-YYYY (European). Uncomment and change to override.
# Common options:
#   %d-%m-%Y  →  25-12-2026  (European, default)
#   %d/%m/%Y  →  25/12/2026  (European with slashes)
#   %Y-%m-%d  →  2026-12-25  (ISO 8601)
#   %m/%d/%Y  →  12/25/2026  (American)
# DATE_FORMAT=%d-%m-%Y

# ---------------------------------------------------------------------------
# Email settings (optional — only needed for the experimental /holiday-notify command)
# ---------------------------------------------------------------------------

# Email address of the company administrator to notify
# COMPANY_ADMIN_EMAIL=admin@example.com

# SMTP server settings
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=holiday-bot@example.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=holiday-bot@example.com

# ---------------------------------------------------------------------------
# Verification tokens for each slash command
# (generated by Mattermost when you register each slash command)
# ---------------------------------------------------------------------------
SLASH_TOKEN_HOLIDAY_ADD=your_token_here
SLASH_TOKEN_HOLIDAY_LIST=your_token_here
SLASH_TOKEN_HOLIDAY_DELETE=your_token_here
SLASH_TOKEN_HOLIDAY_HELP=your_token_here
SLASH_TOKEN_HOLIDAY_NOTIFY=your_token_here
SLASH_TOKEN_HOLIDAY_USER_RENAME=your_token_here
SLASH_TOKEN_BIRTHDAY_SET=your_token_here
SLASH_TOKEN_BIRTHDAY_DELETE=your_token_here
SLASH_TOKEN_AWAY_TODAY=your_token_here
